# подгружаем путь к скриптам
[ -f ~/.my_scripts.conf ] && source ~/.my_scripts.conf

# rclone (dropbox)
alias dropbox-on='rclone mount --daemon dbx: ~/dbx'
alias dropbox-off='fusermount -u ~/dbx'

# git
alias gitka='gitk --all &'
alias gitfdates="$MYSCRIPTS/tools/git_file_dates.py"

# linux things
## Интерактивное обновление системы
alias linux-update='source $MYSCRIPTS/tools/utils.sh; apt_update'
## Создание бэкапа файла с прибавлением номера бэкапа
alias backupf='f() { cp -fv --backup=numbered "$1" "$1"; }; f'
## change xclip to wl-copy, after switching to wayland
alias clipf='f() { cat "$1" | xclip -sel clip; }; f'
## Копирование последней команды в буфер
alias clipcom='history -p !! | xclip -sel clip'
## Вывод размера папок
alias folders-size='du -h --max-depth=1 ./ | sort -hr'
## Сравнение папок
alias difff='diff --color=always -uN'
alias difffr='difff -r'
## Показывает диски в режиме "только для чтения"
alias ro-show='grep "[[:space:]]ro[[:space:],]" /proc/mounts'

# linux info
## Вывод общей информации и копирование её в буфер
alias linux-info='$MYSCRIPTS/tools/linux-info.sh'
## Вывод информации о GPU
alias linux-gpu='inxi -Gxz'
## Вывод дисков с шифрованием luks
alias linux-crypt-disks='sudo blkid | grep crypto_LUKS'

# other
alias myscripts-env='source ~/.my_scripts.conf'
alias ecrontabvim='VISUAL=vim crontab -e'
alias ecrontabnvim='VISUAL=nvim crontab -e'
alias mc='LANG=C.utf8 mc'